server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;
    gzip_min_length 1024;

    # Assets com hash do Vite: cache agressivo
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # index.html nunca é cacheado (garante deploys novos)
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # SPA fallback: rotas client-side caem no index.html
    location / {
        try_files $uri $uri/ /index.html;
    }
}
